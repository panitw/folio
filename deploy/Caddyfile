# folio8 Designer static host, implementing folio8-designer/static-host-contract.json:
#   - /assets/* is content-addressed: served from its .br sidecar when the client
#     accepts brotli, and cached as immutable.
#   - index.html and sw.js are the updateable entries: always revalidated.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv

	header X-Content-Type-Options nosniff

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@updateable path / /index.html /sw.js /offline-release-manifest.json
	header @updateable Cache-Control "no-cache"

	file_server {
		precompressed br
	}
}
