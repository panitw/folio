{
  "name": "folio-designer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:offline": "node scripts/generate-offline-release.mjs",
    "verify:offline": "node scripts/verify-offline-release.mjs",
    "verify:offline:wasm": "node scripts/verify-offline-release.mjs --wasm-witness",
    "verify:offline:red": "node scripts/verify-offline-release.mjs --red-proof",
    "verify:offline:red:controls": "node scripts/verify-offline-release.mjs --red-only",
    "build": "npm run build:wasm && tsc -b && vite build && npm run build:offline && npm run verify:offline",
    "typecheck": "npm run build:wasm && tsc -b",
    "lint": "oxlint",
    "test": "npm run build:wasm && vitest run",
    "test:e2e:compile": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "28.1.0",
    "oxlint": "1.79.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
